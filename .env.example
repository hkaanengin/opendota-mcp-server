# OpenDota API Key (optional)
# Get your API key from: https://www.opendota.com/api-keys
# Leave empty for anonymous access. Sent as the ?api_key= query parameter and never logged.
OPENDOTA_API_KEY=

# Calls per minute (optional). Defaults to 55 without a key and 290 with one,
# just under OpenDota's 60 and 300. Lower it if other software shares your key or IP.
OPENDOTA_RATE_LIMIT_RPM=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
